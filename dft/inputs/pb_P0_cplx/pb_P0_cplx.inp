# Chem-151 | S.T. Yau High School Science Award (Asia) 2026 | Palaash Gang
#
# PRODUCTION ORCA INPUT -- GENERATED FILE, DO NOT EDIT BY HAND.
# Regenerate with:  python dft/make_orca_inputs.py
#
# Job            pb_P0_cplx
# Species        [Pb(LH2)(H2O)4]2+
# Formula        C8H16O9Pb1
# Role           product | protonation P0 | metal Pb
#
# GEOMETRY SOURCE
#   dft/outputs/pb_P0_cplx/pb_P0_cplx.xyz  -- RESTART
#   This is the LAST GEOMETRY of the S04 optimisation attempt, not the
#   S02 conformer. That attempt ran 102 cycles, reached ORCA's default
#   iteration cap without satisfying TightOPT, and therefore never ran
#   its frequency calculation. The energy was converged to ~5e-5 Eh but
#   the step criterion was still oscillating on a flat dihedral plateau.
#   This run CONTINUES that trajectory at the same level of theory with
#   a raised iteration cap. Provenance chain:
#     S02 conformer screen -> dft/structures/pb_P0_cplx.xyz
#       -> S04 partial optimisation (102 cycles, not converged)
#       -> dft/outputs/pb_P0_cplx/pb_P0_cplx.xyz -> this job
#
# LEVEL OF THEORY -- every setting fixed by dft/DFT_PROTOCOL.md.
#   Functional           PBE0 (25% exact exchange)                     §3 'Functional'
#   Dispersion           D3(BJ) — D3 with Becke–Johnson damping        §3 'Dispersion'
#   Basis, all elements  def2-TZVP                                     §3.1
#   Pb core treatment    def2-ECP = Stuttgart–Cologne ECP60MDF, 60     §3.1
#                        core electrons, 22 in valence
#   Cu, Zn, C, H, O      all-electron                                  §3.1
#   Auxiliary basis      def2/J                                        §3.1, §3.4
#   Acceleration         RIJCOSX                                       §3.4
#   Solvation            SMD, solvent = water, applied during the      §3.3
#                        optimisation
#   Geometry convergence TightOPT                                      §3.4
#   SCF convergence      TightSCF                                      §3.4
#   Integration grid     DefGrid3                                      §3.4
#   Frequencies          analytic, same level, same solvent            §3.4
#   Opt+freq             one combined job per species (17 total)       §8
#
# THERMOCHEMISTRY
#   Protocol §3.4 fixes 298.15 K, 1 atm, RRHO with Grimme's quasi-RRHO
#   treatment of modes below 100 cm-1. That treatment is applied in
#   post-processing by analysis/thermo.py from the frequency list printed
#   below, per REACTIONS.md §5.1, NOT by an ORCA keyword -- so that ORCA's
#   own default entropy treatment cannot be silently double-counted.
#
# CHARGE AND MULTIPLICITY
#   Read verbatim from the .xyz provenance header written in S02. Never
#   inferred, never defaulted. Attack A02, rated CRITICAL.
#     charge = +2   multiplicity = 1   unpaired electrons = 0   RKS
# ============================================================================

%pal nprocs 8 end
%maxcore 1500

! PBE0 D3BJ def2-TZVP def2/J RIJCOSX TightSCF DefGrid3 RKS
! Opt Freq TightOPT

# Pb: def2-TZVP carries the def2-ECP automatically, but the ECP is
# declared explicitly here so that the relativistic treatment is
# visible in the input file itself and not only in the output.
# def2-ECP for Pb IS the Stuttgart-Cologne ECP60MDF: 60 core
# electrons replaced, 22 electrons in the valence space, scalar-
# relativistic effects entering through the ECP parameterisation.
# Protocol §3.1 -- attack A03, rated CRITICAL.
%basis
  NewGTO Pb "def2-TZVP" end
  NewECP Pb "def2-ECP"  end
end

# Geometry-optimiser iteration cap. ORCA's default is 3 x N_atoms
# (102 here). In S04 pb_P0_cplx hit that default, stopped without
# converging, and never ran its frequency calculation -- while still
# printing a normal-termination banner. This is a resource cap only:
# it does not alter the TightOPT thresholds of protocol §3.4.
%geom
  MaxIter 300
end

# SMD, water. Geometries are optimised IN SOLUTION -- never optimised in
# gas phase and single-pointed in solvent. Protocol §3.3.
%cpcm
  smd        true
  SMDsolvent "water"
end

