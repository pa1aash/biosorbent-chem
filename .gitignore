# ── Secrets: never, under any circumstances ────────────────────────────────────
*.pem
*.key
id_rsa*
id_ed25519*
.env
.env.*
!.env.example
hcloud.token
dft/hetzner/*.token
dft/hetzner/secrets/
.ssh/

# ── LaTeX build artefacts ──────────────────────────────────────────────────────
# NOTE ON SCOPING. These extensions are scoped to report/ deliberately. A bare
# *.out here would also match ORCA's primary output files, which are the evidence
# every energy in the report has to be traceable to -- they would have been
# silently untracked. Keep LaTeX rules under report/; never make them repo-wide.
report/build/
report/**/*.aux
report/**/*.bbl
report/**/*.bcf
report/**/*.blg
report/**/*.fdb_latexmk
report/**/*.fls
report/**/*.lof
report/**/*.log
report/**/*.lot
report/**/*.out
report/**/*.run.xml
report/**/*.synctex.gz
report/**/*.toc
report/**/*.nav
report/**/*.snm
report/**/*.vrb
report/**/*.xdv
# but the generated numbers file must be inspectable in a diff, so it is NOT ignored:
!report/preamble/numbers.tex

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/

# ── Quantum-chemistry scratch (large, regenerable, or licence-restricted) ──────
# Keep .out, .xyz, .hess and property files. Discard binaries and scratch.
#
# ORCA writes its primary output as .out, and every energy quoted in the report
# must be traceable to one of those files. They are kept by DEFAULT -- nothing in
# this file ignores them, and nothing may be added that does. A repo-wide *.out
# rule (there was one, a LaTeX rule, until 2026-08-13) silently untracks the
# entire evidence base. An explicit "!dft/outputs/**/*.out" negation is
# deliberately NOT used: it would make "git check-ignore" report a match for
# these files, which obscures the check that verifies this invariant, and it
# would need careful ordering against the *_atom*.out rule below to avoid
# re-including the one ORCA output that IS discarded.
dft/outputs/**/*.gbw
dft/outputs/**/*.tmp
dft/outputs/**/*.tmp.*
dft/outputs/**/*.densities
dft/outputs/**/*.densitiesinfo
dft/outputs/**/*.cpcm*
dft/outputs/**/*.bas*
dft/outputs/**/*.opt
dft/outputs/**/*_atom*.out
dft/outputs/**/*.ges
dft/scratch/
*.molden.input.bak

# ── Vendored licence-restricted software: notes are tracked, binaries are not ──
vendor/orca/*
vendor/multiwfn/
vendor/**/*.tar.xz
vendor/**/*.tar.gz
vendor/**/*.zip
vendor/**/*.dmg
!vendor/README*.md
!vendor/jinst/

# ── Reference PDFs are copyrighted; kept locally, not pushed ───────────────────
refs/pdfs/*.pdf

# ── OS and editor noise ────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*~
.vscode/
.idea/

# ── Local-only session scratch ─────────────────────────────────────────────────
.remember/
scratch/
tmp/

# Track only the provenance record, not the ORCA distribution itself
!vendor/orca/README_ORCA.md

# Track only the provenance record, not the ORCA distribution itself
!vendor/orca/README_ORCA.md
